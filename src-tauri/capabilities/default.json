{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Result popup window",
  "windows": ["result"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-translate-text",
    "allow-get-settings",
    "allow-save-settings",
    "allow-save-secret",
    "allow-dismiss"
  ]
}
